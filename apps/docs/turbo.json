{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    // `next build` and `next typegen` (typecheck and lint) both write .next/types, so neither may run
    // beside the other: a half-written type file fails whichever one reads it.
    "typecheck": { "dependsOn": ["^build", "build"] },
    "lint": { "dependsOn": ["^build", "typecheck"] }
  }
}
