exports[`the server face > renders Prose with a wide table to one HTML in en-US, de-DE and fa-IR 1`] = `"<article lang="fa" dir="rtl" class="prose"><h2>گزارش مهر</h2><p>هزینه‌ها <strong>۱۲٪</strong> کمتر از شهریور بود، و <code>budgets.csv</code> به‌روز شد.</p><ol><li>اجاره</li><li>خرید روزانه</li></ol><div aria-label="هزینه بر پایه‌ی دسته، جدول" role="region" tabindex="0" class="prose-scroll"><table><tbody><tr><th scope="row">اجاره</th><td>$1,450.00</td></tr></tbody></table></div></article>"`;

