{
  "color": {
    "$type": "color",
    "canvas": {
      "$value": "#f3f0ee",
      "$description": "The page. Warm putty cream, never pure white.",
      "$extensions": { "snapshot-ui": { "theme": { "dark": "#0e0e0d" } } }
    },
    "lifted": {
      "$value": "#fcfbfa",
      "$description": "A card or panel laid on the canvas.",
      "$extensions": { "snapshot-ui": { "theme": { "dark": "#1a1a19" } } }
    },
    "bone": {
      "$value": "#f4f4f4",
      "$description": "A quiet subregion fill: key hints, notes, code.",
      "$extensions": { "snapshot-ui": { "theme": { "dark": "#252523" } } }
    },
    "float": {
      "$value": "#ffffff",
      "$description": "Chrome that floats on the canvas: the rail, a menu, a toast.",
      "$extensions": { "snapshot-ui": { "theme": { "dark": "#1a1a19" } } }
    },
    "raised": {
      "$value": "#ffffff",
      "$description": "The fill of a control.",
      "$extensions": { "snapshot-ui": { "theme": { "dark": "#252523" } } }
    },
    "disabled": {
      "$value": "#f4f4f4",
      "$description": "The fill of a disabled control. Recessed below raised in both themes.",
      "$extensions": { "snapshot-ui": { "theme": { "dark": "#1a1a19" } } }
    },
    "ink": {
      "$value": "#141413",
      "$description": "Primary text, the primary fill and the focus ring.",
      "$extensions": { "snapshot-ui": { "theme": { "dark": "#ffffff" } } }
    },
    "charcoal": {
      "$value": "#262627",
      "$description": "The primary fill on hover.",
      "$extensions": { "snapshot-ui": { "theme": { "dark": "rgb(255 255 255 / 0.85)" } } }
    },
    "granite": {
      "$value": "#555555",
      "$description": "Small uppercase text that wants more headroom than slate.",
      "$extensions": { "snapshot-ui": { "theme": { "dark": "rgb(255 255 255 / 0.7)" } } }
    },
    "slate": {
      "$value": "#696969",
      "$description": "Hints, notes, secondary labels.",
      "$extensions": { "snapshot-ui": { "theme": { "dark": "rgb(255 255 255 / 0.6)" } } }
    },
    "taupe": {
      "$value": "#d1cdc7",
      "$description": "Placeholder and disabled text only. Never text the reader must read.",
      "$extensions": { "snapshot-ui": { "theme": { "dark": "rgb(255 255 255 / 0.4)" } } }
    },
    "link": {
      "$value": "#3860be",
      "$description": "Inline links and informational tone.",
      "$extensions": { "snapshot-ui": { "theme": { "dark": "#6c8ee0" } } }
    },
    "signal": {
      "$value": "#cf4500",
      "$description": "Reserved for consent, legal and compliance actions."
    },
    "signal-light": {
      "$value": "#f37338",
      "$description": "Attention cue: the changed border and the eyebrow dot. Never body color."
    },
    "clay": {
      "$value": "#9a3a0a",
      "$description": "Reserved for unsaved changes.",
      "$extensions": { "snapshot-ui": { "theme": { "dark": "#d9925f" } } }
    },
    "error": {
      "$value": "#a3231b",
      "$description": "Reserved for failure and invalid values.",
      "$extensions": { "snapshot-ui": { "theme": { "dark": "#e8705f" } } }
    },
    "success": {
      "$value": "#2a5f46",
      "$description": "Reserved for success.",
      "$extensions": { "snapshot-ui": { "theme": { "dark": "#5aac80" } } }
    },
    "warning": {
      "$value": "#8a5300",
      "$description": "A state that needs a look soon and is not a failure: Watch, Behind, Needs review, Out of date. Never decoration.",
      "$extensions": { "snapshot-ui": { "theme": { "dark": "#e8b04f" } } }
    },
    "gain": {
      "$value": "#2a5f46",
      "$description": "Money in: an amount that arrived. Never decoration, and not the success state.",
      "$extensions": { "snapshot-ui": { "theme": { "dark": "#6cc195" } } }
    },
    "boundary": {
      "$value": "rgb(20 20 19 / 0.5)",
      "$description": "The boundary of a control. Ink at 50%, the document's input border, measured at 3:1 or more.",
      "$extensions": { "snapshot-ui": { "theme": { "dark": "rgb(255 255 255 / 0.5)" } } }
    },
    "frame": {
      "$value": "rgb(20 20 19 / 0.12)",
      "$description": "The outline of a list or a float surface opening over another float surface.",
      "$extensions": { "snapshot-ui": { "theme": { "dark": "rgb(255 255 255 / 0.12)" } } }
    },
    "divider": {
      "$value": "rgb(20 20 19 / 0.1)",
      "$description": "A rule inside a surface, such as a card's header band.",
      "$extensions": { "snapshot-ui": { "theme": { "dark": "rgb(255 255 255 / 0.1)" } } }
    },
    "hairline": {
      "$value": "transparent",
      "$description": "A surface's own edge. Nothing in light, where tone separates; white 12% in dark.",
      "$extensions": { "snapshot-ui": { "theme": { "dark": "rgb(255 255 255 / 0.12)" } } }
    },
    "scrim": {
      "$value": "#050505",
      "$description": "Deep Well, the fill behind a dialog or drawer. Fixed in both themes."
    },
    "scrollbar": {
      "$value": "rgb(20 20 19 / 0.22)",
      "$description": "A scrollbar thumb.",
      "$extensions": { "snapshot-ui": { "theme": { "dark": "rgb(255 255 255 / 0.22)" } } }
    },
    "scrollbar-hover": {
      "$value": "rgb(20 20 19 / 0.4)",
      "$description": "A scrollbar thumb under the pointer.",
      "$extensions": { "snapshot-ui": { "theme": { "dark": "rgb(255 255 255 / 0.4)" } } }
    },
    "chart-1": {
      "$value": "#029393",
      "$description": "A chart series that is one of several peers. Never a state, never text.",
      "$extensions": { "snapshot-ui": { "theme": { "dark": "#029393" } } }
    },
    "chart-2": {
      "$value": "#7024ab",
      "$description": "A chart series that is one of several peers. Never a state, never text.",
      "$extensions": { "snapshot-ui": { "theme": { "dark": "#af6af2" } } }
    },
    "chart-3": {
      "$value": "#697805",
      "$description": "A chart series that is one of several peers. Never a state, never text.",
      "$extensions": { "snapshot-ui": { "theme": { "dark": "#7a8a06" } } }
    },
    "chart-4": {
      "$value": "#910080",
      "$description": "A chart series that is one of several peers. Never a state, never text.",
      "$extensions": { "snapshot-ui": { "theme": { "dark": "#c344ae" } } }
    }
  },
  "opacity": {
    "$type": "number",
    "scrim": {
      "$value": 0.4,
      "$description": "How much the scrim dims. A near-black page needs more to register.",
      "$extensions": { "snapshot-ui": { "theme": { "dark": 0.65 } } }
    }
  },
  "font": {
    "$type": "fontFamily",
    "sans": {
      "$value": ["Sofia Sans", "Sofia Sans Variable", "Inter", "Arial", "sans-serif"],
      "$description": "The one family. Needs the variable build for weight 450. Sofia Sans Variable is the family name Fontsource's self-hosted package registers."
    },
    "mono": {
      "$value": ["ui-monospace", "SFMono-Regular", "Menlo", "monospace"],
      "$description": "Code only."
    }
  },
  "text": {
    "h1": {
      "size": { "$type": "dimension", "$value": { "value": 4, "unit": "rem" } },
      "line-height": { "$type": "number", "$value": 1 },
      "letter-spacing": { "$type": "dimension", "$value": { "value": -0.02, "unit": "em" } },
      "font-weight": { "$type": "fontWeight", "$value": 500 }
    },
    "h2": {
      "size": { "$type": "dimension", "$value": { "value": 2.25, "unit": "rem" } },
      "line-height": { "$type": "number", "$value": 1.222 },
      "letter-spacing": { "$type": "dimension", "$value": { "value": -0.02, "unit": "em" } },
      "font-weight": { "$type": "fontWeight", "$value": 500 }
    },
    "h3": {
      "size": { "$type": "dimension", "$value": { "value": 1.5, "unit": "rem" } },
      "line-height": { "$type": "number", "$value": 1.2 },
      "letter-spacing": { "$type": "dimension", "$value": { "value": -0.02, "unit": "em" } },
      "font-weight": { "$type": "fontWeight", "$value": 500 }
    },
    "h4": {
      "size": { "$type": "dimension", "$value": { "value": 0.875, "unit": "rem" } },
      "line-height": { "$type": "number", "$value": 1.3 },
      "font-weight": { "$type": "fontWeight", "$value": 700 }
    },
    "eyebrow": {
      "size": { "$type": "dimension", "$value": { "value": 0.875, "unit": "rem" } },
      "line-height": { "$type": "number", "$value": 1 },
      "letter-spacing": { "$type": "dimension", "$value": { "value": 0.04, "unit": "em" } },
      "font-weight": { "$type": "fontWeight", "$value": 700 }
    },
    "body": {
      "size": { "$type": "dimension", "$value": { "value": 1, "unit": "rem" } },
      "line-height": { "$type": "number", "$value": 1.4 },
      "font-weight": { "$type": "fontWeight", "$value": 450 }
    },
    "action": {
      "size": { "$type": "dimension", "$value": { "value": 1, "unit": "rem" } },
      "line-height": { "$type": "number", "$value": 1 },
      "letter-spacing": { "$type": "dimension", "$value": { "value": -0.03, "unit": "em" } },
      "font-weight": { "$type": "fontWeight", "$value": 500 }
    },
    "small": {
      "size": { "$type": "dimension", "$value": { "value": 0.875, "unit": "rem" } },
      "line-height": { "$type": "number", "$value": 1.43 },
      "font-weight": { "$type": "fontWeight", "$value": 450 }
    },
    "overline": {
      "size": { "$type": "dimension", "$value": { "value": 0.875, "unit": "rem" } },
      "line-height": { "$type": "number", "$value": 1 },
      "letter-spacing": { "$type": "dimension", "$value": { "value": 0.04, "unit": "em" } },
      "font-weight": { "$type": "fontWeight", "$value": 700 }
    },
    "numeral": {
      "size": { "$type": "dimension", "$value": { "value": 3.5, "unit": "rem" } },
      "line-height": { "$type": "number", "$value": 1 },
      "letter-spacing": { "$type": "dimension", "$value": { "value": -0.03, "unit": "em" } },
      "font-weight": { "$type": "fontWeight", "$value": 500 }
    },
    "numeral-sm": {
      "size": { "$type": "dimension", "$value": { "value": 2, "unit": "rem" } },
      "line-height": { "$type": "number", "$value": 1.1 },
      "letter-spacing": { "$type": "dimension", "$value": { "value": -0.02, "unit": "em" } },
      "font-weight": { "$type": "fontWeight", "$value": 500 }
    }
  },
  "radius": {
    "$type": "dimension",
    "micro": {
      "$value": { "value": 6, "unit": "px" },
      "$description": "Checkboxes, badges, key hints, tooltips.",
      "$extensions": {
        "snapshot-ui": {
          "shape": { "soft": { "value": 6, "unit": "px" }, "square": { "value": 0, "unit": "px" } }
        }
      }
    },
    "control": {
      "$value": { "value": 20, "unit": "px" },
      "$description": "Buttons, tiles, rows that light up.",
      "$extensions": {
        "snapshot-ui": {
          "shape": { "soft": { "value": 10, "unit": "px" }, "square": { "value": 0, "unit": "px" } }
        }
      }
    },
    "surface": {
      "$value": { "value": 24, "unit": "px" },
      "$description": "Popups, menus, nested cards, field frames, lists, previews.",
      "$extensions": {
        "snapshot-ui": {
          "shape": { "soft": { "value": 12, "unit": "px" }, "square": { "value": 0, "unit": "px" } }
        }
      }
    },
    "stadium": {
      "$value": { "value": 40, "unit": "px" },
      "$description": "Panel cards, dialogs, the sidebar rail.",
      "$extensions": {
        "snapshot-ui": {
          "shape": { "soft": { "value": 16, "unit": "px" }, "square": { "value": 0, "unit": "px" } }
        }
      }
    },
    "pill": {
      "$value": { "value": 999, "unit": "px" },
      "$description": "Inputs, icon buttons, segmented tracks, chips, switches, avatars.",
      "$extensions": {
        "snapshot-ui": {
          "shape": { "soft": { "value": 12, "unit": "px" }, "square": { "value": 0, "unit": "px" } }
        }
      }
    },
    "dot": {
      "$value": "50%",
      "$description": "Round in every shape: radio indicators, status dots, slider thumbs, spinners."
    }
  },
  "shadow": {
    "$type": "shadow",
    "lift": {
      "$value": {
        "color": "rgb(0 0 0 / 0.04)",
        "offsetX": { "value": 0, "unit": "px" },
        "offsetY": { "value": 4, "unit": "px" },
        "blur": { "value": 24, "unit": "px" },
        "spread": { "value": 0, "unit": "px" }
      },
      "$description": "Level 1: floating chrome.",
      "$extensions": {
        "snapshot-ui": {
          "theme": {
            "dark": {
              "color": "rgb(0 0 0 / 0.4)",
              "offsetX": { "value": 0, "unit": "px" },
              "offsetY": { "value": 4, "unit": "px" },
              "blur": { "value": 24, "unit": "px" },
              "spread": { "value": 0, "unit": "px" }
            }
          }
        }
      }
    },
    "float": {
      "$value": {
        "color": "rgb(0 0 0 / 0.08)",
        "offsetX": { "value": 0, "unit": "px" },
        "offsetY": { "value": 24, "unit": "px" },
        "blur": { "value": 48, "unit": "px" },
        "spread": { "value": 0, "unit": "px" }
      },
      "$description": "Level 2: popups, dialogs, elevated cards.",
      "$extensions": {
        "snapshot-ui": {
          "theme": {
            "dark": {
              "color": "rgb(0 0 0 / 0.5)",
              "offsetX": { "value": 0, "unit": "px" },
              "offsetY": { "value": 24, "unit": "px" },
              "blur": { "value": 48, "unit": "px" },
              "spread": { "value": 0, "unit": "px" }
            }
          }
        }
      }
    },
    "dramatic": {
      "$value": {
        "color": "rgb(0 0 0 / 0.25)",
        "offsetX": { "value": 0, "unit": "px" },
        "offsetY": { "value": 70, "unit": "px" },
        "blur": { "value": 110, "unit": "px" },
        "spread": { "value": 0, "unit": "px" }
      },
      "$description": "Level 3: rare.",
      "$extensions": {
        "snapshot-ui": {
          "theme": {
            "dark": {
              "color": "rgb(0 0 0 / 0.6)",
              "offsetX": { "value": 0, "unit": "px" },
              "offsetY": { "value": 70, "unit": "px" },
              "blur": { "value": 110, "unit": "px" },
              "spread": { "value": 0, "unit": "px" }
            }
          }
        }
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "part": {
      "$value": { "value": 8, "unit": "px" },
      "$description": "Parts of one thing: label to control to hint."
    },
    "peer": {
      "$value": { "value": 24, "unit": "px" },
      "$description": "Peers in a list: field to the field below."
    },
    "separate": {
      "$value": { "value": 32, "unit": "px" },
      "$description": "Separate things: card to card, field beside field."
    },
    "page": { "$value": { "value": 48, "unit": "px" }, "$description": "The page's own margin." },
    "card": {
      "$value": { "value": 32, "unit": "px" },
      "$description": "A card's own padding, and the bleed of its header band.",
      "$extensions": { "snapshot-ui": { "density": { "compact": { "value": 20, "unit": "px" } } } }
    },
    "inset": {
      "$value": { "value": 16, "unit": "px" },
      "$description": "How far floating chrome sits clear of the viewport edge: the rail, a drawer, the skip link."
    }
  },
  "container": {
    "$type": "dimension",
    "field": {
      "$value": { "value": 44, "unit": "rem" },
      "$description": "The widest a single control grows."
    },
    "page": {
      "$value": { "value": 82.5, "unit": "rem" },
      "$description": "The page column's width, its inline padding included: a PageHeader's row and the content under it. Past it the column is centered in the workspace."
    },
    "sidebar": {
      "$value": { "value": 20, "unit": "rem" },
      "$description": "The rail's full width, insets included. The workspace is offset by it.",
      "$extensions": { "snapshot-ui": { "sidebar": { "collapsed": { "value": 6.5, "unit": "rem" } } } }
    }
  },
  "size": {
    "$type": "dimension",
    "control": {
      "$value": { "value": 40, "unit": "px" },
      "$description": "A control's height: buttons, icon buttons, the sm segmented track. The document's touch floor.",
      "$extensions": {
        "snapshot-ui": {
          "density": {
            "compact": { "value": 36, "unit": "px" },
            "compact-coarse": { "value": 44, "unit": "px" }
          }
        }
      }
    },
    "field": {
      "$value": { "value": 48, "unit": "px" },
      "$description": "A field's height: the text input, the segmented track.",
      "$extensions": {
        "snapshot-ui": {
          "density": {
            "compact": { "value": 36, "unit": "px" },
            "compact-coarse": { "value": 44, "unit": "px" }
          }
        }
      }
    },
    "target": {
      "$value": { "value": 40, "unit": "px" },
      "$description": "The floor a hit area is extended to. Not density-driven: nothing interactive drops below it."
    }
  },
  "breakpoint": {
    "$type": "dimension",
    "sm": { "$value": { "value": 768, "unit": "px" }, "$description": "Tablet entry." },
    "md": { "$value": { "value": 1024, "unit": "px" }, "$description": "Desktop entry." },
    "lg": { "$value": { "value": 1440, "unit": "px" }, "$description": "Wide entry." }
  },
  "focus-ring": {
    "$type": "dimension",
    "width": { "$value": { "value": 2, "unit": "px" } },
    "offset": { "$value": { "value": 2, "unit": "px" } },
    "color": {
      "$type": "color",
      "$value": "{color.ink}",
      "$description": "The color of every focus ring. A reference to ink, so it follows the theme and a theme can recolor every ring from this one token."
    }
  },
  "z": {
    "$type": "number",
    "modal": {
      "$value": 1000,
      "$description": "Dialogs, drawers, sheets, the palette and their scrims. Below React Aria's positioned overlays, which sit at 100000 inline."
    },
    "toast": {
      "$value": 1100,
      "$description": "The toast region, above every modal, so an error raised from inside a dialog is not under the scrim."
    },
    "header": {
      "$value": 20,
      "$description": "A sticky page header: above the page it scrolls over, under every piece of fixed chrome."
    },
    "chrome": {
      "$value": 30,
      "$description": "Fixed chrome: the rail, its collapse button, the tab bar, a save bar. Under every modal."
    }
  },
  "ease": {
    "$type": "cubicBezier",
    "emphasized": {
      "$value": [0.2, 0, 0, 1],
      "$description": "Material 3's emphasized curve: a quick start and a long, soft landing. For a container that changes size in place, such as the rail opening and closing, and every property that moves with it."
    }
  },
  "duration": {
    "$type": "duration",
    "expand": {
      "$value": { "value": 300, "unit": "ms" },
      "$description": "A container growing in place: the rail opening, and the workspace, the chevron and the labels moving with it."
    },
    "collapse": {
      "$value": { "value": 250, "unit": "ms" },
      "$description": "A container shrinking in place: the rail closing. A little quicker than expanding, since what leaves needs less attention than what arrives."
    }
  }
}
